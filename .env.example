NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_crm
REDIS_URL=redis://127.0.0.1:6379

# Use long random values in production (≥32 chars, not placeholders, secrets must differ)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

LOG_LEVEL=info

# Comma-separated browser origins (required when NODE_ENV=production)
# CORS_ORIGINS=https://app.example.com

# Behind nginx/ALB set to 1 (or hop count)
TRUST_PROXY=0

# Optional tuning
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900

# Background jobs (outbox dispatcher, reminders, housekeeping). Default: run inside the API.
# Set false on API instances if you run `npm run worker` separately.
# RUN_WORKERS_IN_API=true
# OUTBOX_MAX_ATTEMPTS=8

# Real email (required for successful sends when NODE_ENV=production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Hotel CRM <noreply@example.com>"

# Unsubscribe links in campaign emails (both required when NODE_ENV=production)
# PUBLIC_BASE_URL=https://api.example.com
# UNSUBSCRIBE_SECRET=<32+ random chars, different from the JWT secrets>
# UNSUBSCRIBE_TOKEN_TTL_DAYS=365

# Sender identity & delivery events (optional)
# EMAIL_ALLOWED_FROM_DOMAINS=example.com        # domains hotels may use as their campaign from-address
# DELIVERY_WEBHOOK_SECRET=<16+ chars>            # defaults to a key derived from UNSUBSCRIBE_SECRET

# Campaign sending (all optional)
# CAMPAIGN_SEND_RATE_PER_SEC=10        # default msgs/sec per hotel; override per hotel via PATCH /properties/:id
# CAMPAIGN_BATCH_SIZE=100
# CAMPAIGN_SLICE_MS=30000
# CAMPAIGN_LEASE_MS=60000
# CAMPAIGN_MAX_CONSECUTIVE_FAILURES=25
# CAMPAIGN_STALL_MINUTES=15
# CAMPAIGN_TEST_SEND_MAX_PER_HOUR=10   # test emails (POST /campaigns/:id/test-send) per user per hour

# Seed (never run against production without ALLOW_PROD_SEED=true + strong password)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMe123!
# ALLOW_PROD_SEED=false
